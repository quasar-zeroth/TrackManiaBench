<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools/**;validation/**;publish/**</DefaultItemExcludes>
    <AssemblyName>TrackmaniaExtractor</AssemblyName>
    <Version>0.1.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GBX.NET" Version="[2.5.1]" />
    <PackageReference Include="GBX.NET.LZO" Version="[2.1.6]" />
    <PackageReference Include="GBX.NET.ZLib" Version="[1.1.3]" />
    <PackageReference Include="TmEssentials" Version="[2.8.0]" />
  </ItemGroup>
</Project>
